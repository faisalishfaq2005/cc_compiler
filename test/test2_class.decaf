
/* Test 2: Class declarations and inheritance */
class Animal {
    string name;
    int age;

    void speak() {
        Print("...");
    }

    string getName() {
        return name;
    }
}

class Dog extends Animal {
    void speak() {
        Print("Woof!");
    }
}

void main() {
    Dog d;
    d = New(Dog);
    d.speak();
}
